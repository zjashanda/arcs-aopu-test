{
  "serial": {
    "port": "COM26",
    "baud": 921600
  },
  "playback": {
    "volume": 20,
    "use_default_soundcard_only": true
  },
  "audio": {
    "dir": "wav",
    "wake_file": "你好小奥.wav",
    "open_file": "打开浴霸.wav",
    "close_file": "关闭浴霸.wav"
  },
  "pressure": {
    "max_wake_retries_on_command_miss": 6,
    "wake_retry_gap_seconds": 0.8,
    "timeout_wait_seconds": 35.0,
    "retry_until_timeout": true,
    "initial_wake_max_attempts": 20,
    "initial_wake_timeout_seconds": 8.0,
    "post_app_ready_grace_seconds": 3.0
  },
  "logging": {
    "out_dir": "result",
    "fsync": true,
    "separate_serial_and_tool_logs": true,
    "timestamp_format": "milliseconds",
    "serial_capture_mode": "xshell_readable_lines",
    "serial_log_fields": [
      "xshell_begin_end",
      "timestamp",
      "terminal_processed_serial_line"
    ],
    "tool_log_detail": "verbose_actions_and_analysis",
    "serial_log_files": {
      "serial": "COM028_921600_yyyy-MM-dd_HH_mm_ss.log",
      "tool": "*.tool.log"
    }
  }
}
